project_name: {{ project_name }}
max_teammates: 5
playbook_mode: guide
lead_cli: claude   # S11+ may add codex / agy
allowed_personas:
  - planner
  - implementer
  - reviewer
  - tester
default_playbook: new-feature

# Cost-aware role -> CLI remap (optional, S15c). Keyed by persona NAME; the value
# must be a supported teammate CLI. Lets a persona run under a cheaper / higher-quota
# CLI without forking its persona file. Unset = each persona uses its own `cli`.
# Cost recipe — run heavy implementer/tester work on agy, keep claude for reasoning:
#   role_cli_overrides:
#     implementer: agy
#     tester: agy

# Worktree isolation (optional, S17 — containment). When true, each write-capable
# teammate (workspace-write persona) runs in its own `git worktree` under the
# session dir instead of the shared checkout; the lead/reviewer integrates by merge.
# Requires the project to be a git repo. Recommended (effectively required) for
# unattended/autonomous runs. Unset/false = teammates share the project checkout.
#   isolate_worktrees: true

sandbox:
  implementer: workspace-write
  tester: workspace-write

forbidden_paths:
{% for path in forbidden_paths %}
  - {{ path }}
{% endfor %}

lead_context_files:
  - TEAM.md
  - README.md
  - .agent-team/playbooks/{playbook}.yaml
